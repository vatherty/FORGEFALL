; Engine configuration file.
; FORGEFALL — voxel FPS for Android. Godot 4.7.2-stable target.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="FORGEFALL"
config/description="Voxel-styled tactical FPS: MW2 game-feel meets Minecraft chunk. Fight militia waves, forge gear live with the Forge AI console, call 3/5/7 killstreaks."
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/core/game_state.gd"
Sfx="*res://scripts/audio/audio_manager.gd"
Forge="*res://scripts/forge/forge_manager.gd"
Updater="*res://scripts/core/update_manager.gd"
UpdaterPC="*res://scripts/core/update_manager_pc.gd"
NetManager="*res://scripts/net/net_manager.gd"
Progression="*res://scripts/progression/progression.gd"
Loadouts="*res://scripts/progression/loadouts.gd"
Stats="*res://scripts/progression/stats.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/ForgeUpdater/plugin.cfg")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

sensors/enable_gyroscope=true
; v0.5.1: NEVER emulate mouse from touch. With the default (true), every
; Android tap synthesizes a mouse click, and `fire` is bound to mouse
; button 1 — so ANY tap fired the gun. Touch input goes through the touch
; layer's Input.action_press calls, never through emulated mouse clicks.
; Desktop mouse is real hardware and is unaffected.
; v0.6.6 intake: GPT's mobile-HUD patch flipped this to true, relying on
; MouseCapture; the flip is HELD BACK (verify_v051 locks the false
; default, and the guarantee must not rest on runtime state alone).
; GPT's runtime half is kept: MouseCapture.set_menu() enables emulation
; while menus are up (Main calls it at boot and on every menu return)
; and set_gameplay() disables it — merged behavior is unchanged in
; every state, proven by tools/verify_emulate_mouse_safety.gd.
; (Godot project.godot comments use ';' — '#' lines are parsed as keys
; and would swallow the setting below.)
pointing/emulate_mouse_from_touch=false

; Gamepad (Xbox-style / Steam Deck): joypad events are APPENDED to the
; existing keyboard/mouse actions below — no action renamed, no KB/M binding
; removed. Left stick = move axes, RT = fire, LT = ADS, A = jump, B = crouch,
; X = reload, Y = interact, LB = grapple, RB = Forge, L3 = sprint,
; D-pad Up/Right/Down = weapon slots 1/2/3, Start = pause.
; Right stick has no InputMap action (sticks are polled, not event-driven):
; player.gd polls it every frame and feeds add_look() radians. Deadzone 0.2
; throughout (action deadzone + gamepad poll deadzone in player.gd).
