extends SceneTree

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	var fixture := ProjectSettings.globalize_path("user://forgefall_fixture_" + str(Time.get_ticks_usec()))
	DirAccess.make_dir_recursive_absolute(fixture)
	var config := FileAccess.open(fixture.path_join("project.godot"), FileAccess.WRITE)
	config.store_string("config_version=5\n[application]\nconfig/name=\"Forgefall\"\n")
	config.close()
	DirAccess.make_dir_recursive_absolute(fixture.path_join("tools"))
	DirAccess.make_dir_recursive_absolute(fixture.path_join("studio/shared"))
	for name in ["document_store.gd", "asset_document.gd", "voxel_mesh.gd"]:
		var shared := FileAccess.open(fixture.path_join("studio/shared").path_join(name), FileAccess.WRITE)
		shared.store_string(FileAccess.get_file_as_string(ProjectSettings.globalize_path("res://shared/" + name)))
		shared.close()
	var helper := FileAccess.open(fixture.path_join("tools/studio_generate.gd"), FileAccess.WRITE)
	helper.store_string(FileAccess.get_file_as_string(ProjectSettings.globalize_path("res://../tools/studio_generate.gd")))
	helper.close()
	var scene: PackedScene = load("res://main.tscn")
	var studio: Control = scene.instantiate()
	root.add_child(studio)
	studio._open_project(fixture)
	assert(studio.project_path == fixture)
	studio._new_map()
	studio._add_block()
	assert(studio.map_doc["instances"].size() == 1)
	studio._undo()
	assert(studio.map_doc["instances"].size() == 0)
	studio._redo()
	assert(studio.map_doc["instances"].size() == 1)
	var id: String = studio.map_doc["id"]
	studio._save()
	assert(FileAccess.file_exists(fixture.path_join("assets/studio/maps").path_join(id + ".json")))
	studio._publish_map()
	assert(FileAccess.file_exists(fixture.path_join("assets/studio/generated/maps").path_join(id + ".tscn")))
	studio._edit_axis("2.26", 0)
	assert(is_equal_approx(studio.map_doc["instances"][0]["position"][0], 2.25))
	studio._autosave()
	assert(FileAccess.file_exists(ProjectSettings.globalize_path(studio._recovery_path())))
	var saved_path: String = fixture.path_join("assets/studio/maps").path_join(id + ".json")
	var external: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(saved_path))
	external["name"] = "External edit"
	var external_file := FileAccess.open(saved_path, FileAccess.WRITE)
	external_file.store_string(JSON.stringify(external))
	external_file.close()
	studio._save()
	assert(studio.status.text.contains("changed on disk"))
	assert(JSON.parse_string(FileAccess.get_file_as_string(saved_path))["name"] == "External edit")
	studio._open_project(fixture)
	assert(studio.map_doc["id"] == id)
	studio._restore_recovery()
	assert(is_equal_approx(studio.map_doc["instances"][0]["position"][0], 2.25))
	print("Workflow test passed: open, create, edit, undo/redo, save, publish, autosave, external conflict, recovery")
	quit()
