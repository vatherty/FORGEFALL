extends SceneTree
const Asset = preload("res://shared/asset_document.gd")
const Mesher = preload("res://shared/voxel_mesh.gd")

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	var doc: Dictionary = Asset.create("Stage 2")
	doc = Asset.stamp(doc, Vector3i.ZERO, "Sphere", 1, 0)
	assert(doc["voxels"].size() == 7)
	doc = Asset.stamp(doc, Vector3i(3, 0, 0), "Box", 0, 1, 0, false, Vector3i(1, 0, 0))
	assert(Asset.find_index(doc, 3, 0, 0) >= 0)
	assert(Asset.find_index(doc, -3, 0, 0) >= 0)
	doc = Asset.flood_fill(doc, Vector3i.ZERO, 2)
	assert(int(doc["voxels"][Asset.find_index(doc, 0, 0, 0)]["material"]) == 2)
	assert(int(doc["voxels"][Asset.find_index(doc, 3, 0, 0)]["material"]) == 1)
	doc = Asset.stamp(doc, Vector3i.ZERO, "Sphere", 1, 0, 0, true)
	assert(doc["voxels"].size() == 2)
	assert(Asset.validate(doc) == "")
	var scene: PackedScene = load("res://asset_workshop.tscn")
	var workshop: Control = scene.instantiate()
	workshop.project_path = ProjectSettings.globalize_path("user://stage2_fixture_" + str(Time.get_ticks_usec()))
	root.add_child(workshop)
	workshop._add_layer()
	assert(workshop.asset_doc["layers"].size() == 2)
	workshop.axis_inputs[0].value = 2
	workshop._set_pivot()
	assert(is_equal_approx(float(workshop.asset_doc["origin"][0]), 0.25))
	workshop._set_collision(1)
	assert(workshop.asset_doc["collision"] == "none")
	workshop.attachment_input.text = "Muzzle"
	workshop._add_attachment()
	assert(workshop.asset_doc["attachments"].size() == 1)
	workshop._set_tool("Place")
	workshop.stroke_cells.append(Vector3i(4, 0, 0))
	workshop.stroke_cells.append(Vector3i(5, 0, 0))
	workshop._finish_stroke()
	assert(Asset.find_index(workshop.asset_doc, 4, 0, 0) >= 0)
	assert(Asset.find_index(workshop.asset_doc, 5, 0, 0) >= 0)
	workshop._undo()
	assert(Asset.find_index(workshop.asset_doc, 4, 0, 0) < 0)
	assert(Asset.find_index(workshop.asset_doc, 5, 0, 0) < 0)
	var node: Node3D = Mesher.build_node(workshop.asset_doc, true)
	assert(node.get_node_or_null("Muzzle") != null)
	assert(node.get_node_or_null("Collision_0_0_0") == null)
	node.free()
	assert(Asset.validate(workshop.asset_doc) == "")
	var image := Image.create_empty(2, 2, false, Image.FORMAT_RGBA8)
	image.fill(Color.RED)
	var reference_path: String = workshop.project_path.path_join("reference.png")
	DirAccess.make_dir_recursive_absolute(workshop.project_path)
	assert(image.save_png(reference_path) == OK)
	workshop._add_reference(reference_path)
	assert(workshop.asset_doc["references"].size() == 1)
	assert(workshop.reference_preview.texture != null)
	await process_frame
	await process_frame
	workshop._save_thumbnail()
	assert(workshop.status.text == "Thumbnail capture needs a visible window.")
	var sculpt: Dictionary = Asset.create("Sculpt")
	sculpt = Asset.set_voxel(sculpt, 0, 0, 0, 0)
	assert(Asset.smooth(sculpt, Vector3i.ZERO, 0, 0, 0)["voxels"].is_empty())
	sculpt = Asset.deform(sculpt, Vector3i.ZERO, 0, Vector3i.UP, 0)
	assert(Asset.find_index(sculpt, 0, 1, 0) >= 0)
	sculpt = Asset.set_voxel(sculpt, 0, 2, 0, 0)
	assert(Asset.same(Asset.deform(sculpt, Vector3i(0, 1, 0), 0, Vector3i.UP, 0), sculpt))
	var layered: Dictionary = Asset.create("Layer collision")
	layered["layers"].append({"name": "Upper", "visible": true, "collision": true})
	layered = Asset.set_voxel(layered, 0, 0, 0, 0, 0)
	layered = Asset.set_voxel(layered, 20, 0, 0, 0, 1)
	layered = Asset.rename_layer(layered, 1, "Upper renamed")
	assert(layered["layers"][1]["name"] == "Upper renamed")
	layered = Asset.move_layer(layered, 1, -1)
	assert(layered["layers"][0]["name"] == "Upper renamed")
	assert(int(layered["voxels"][Asset.find_index(layered, 20, 0, 0)]["layer"]) == 0)
	layered["layers"][1]["collision"] = false
	var collision_node: Node3D = Mesher.build_node(layered, true)
	assert(collision_node.get_node_or_null("Collision_1_0_0") != null)
	assert(collision_node.get_node_or_null("Collision_0_0_0") == null)
	collision_node.free()
	layered = Asset.merge_layer_down(layered, 1)
	assert(layered["layers"].size() == 1)
	assert(int(layered["voxels"][Asset.find_index(layered, 0, 0, 0)]["layer"]) == 0)
	assert(Asset.validate(layered) == "")
	workshop.attachment_index = 0
	workshop.attachment_input.text = "Edited"
	workshop._update_attachment()
	assert(workshop.asset_doc["attachments"][0]["name"] == "Edited")
	workshop._delete_attachment()
	assert(workshop.asset_doc["attachments"].is_empty())
	var legacy: Dictionary = Asset.create("Legacy")
	legacy.erase("layers")
	legacy.erase("references")
	legacy = Asset.set_voxel(legacy, 0, 0, 0, 0)
	legacy["voxels"][0].erase("layer")
	assert(Asset.validate(legacy) == "")
	legacy = Asset.rename_layer(legacy, 0, "Renamed base")
	assert(legacy["layers"][0]["name"] == "Renamed base")
	print("Asset tools test passed: shapes, symmetry, fill, layers, pivot, collision, attachments, stroke undo, references, headless thumbnail guard, smoothing, deformation, layer edits, collision mask, attachment edits")
	quit()
