extends RefCounted

const Document = preload("res://behavior_document.gd")
const Store = preload("res://shared/document_store.gd")

static func compile(doc: Dictionary) -> Dictionary:
	var problem := Document.validate(doc)
	if not problem.is_empty():
		return {"error": problem, "source": ""}
	var nodes := {}
	var flow := {}
	for entry in doc["nodes"]:
		nodes[str(entry["id"])] = entry
		flow[str(entry["id"])] = {}
	for edge in doc["edges"]:
		var slot := str(edge.get("port", "next"))
		flow[str(edge["from"])][slot] = str(edge["to"])
	var lines: Array[String] = ["extends Node3D", "# Generated by Forgefall Studio from behavior %s." % str(doc.get("id", "")), "# Edit the behavior document; this file is replaced on publication.", "signal behavior_event(name: String)", "signal behavior_step(id: String)", "signal behavior_paused(id: String)", "signal behavior_continue", "var debug_breakpoints: Array[String] = []", "", "func resume_behavior() -> void:", "\tbehavior_continue.emit()", "", "func _trace_step(id: String) -> void:", "\tbehavior_step.emit(id)", "\tif debug_breakpoints.has(id):", "\t\tbehavior_paused.emit(id)", "\t\tawait behavior_continue", ""]
	if nodes.values().any(func(entry: Dictionary) -> bool: return entry["type"] == "condition"):
		lines.append_array(["func _behavior_compare(node: Node, property: String, operator: String, expected: Variant) -> bool:", "\tvar actual: Variant = node.get(property) if node != null else null", "\tif operator == \"==\":", "\t\treturn actual == expected", "\tif operator == \"!=\":", "\t\treturn actual != expected", "\tif actual == null:", "\t\treturn false", "\tvar numeric := (actual is int or actual is float) and (expected is int or expected is float)", "\tvar textual := actual is String and expected is String", "\tif not numeric and not textual:", "\t\treturn false", "\tmatch operator:", "\t\t\">\":", "\t\t\treturn actual > expected", "\t\t\">=\":", "\t\t\treturn actual >= expected", "\t\t\"<\":", "\t\t\treturn actual < expected", "\t\t\"<=\":", "\t\t\treturn actual <= expected", "\treturn false", ""])
	lines.append("func _ready() -> void:")
	var events: Array = []
	for entry in doc["nodes"]:
		if ["ready", "interact", "timer"].has(str(entry["type"])):
			events.append(entry)
	if events.is_empty():
		lines.append("\tpass")
	for index in events.size():
		var event: Dictionary = events[index]
		match str(event["type"]):
			"ready":
				lines.append("\t_run_%d()" % index)
			"timer":
				lines.append("\t_timer_%d()" % index)
	if not events.any(func(e: Dictionary) -> bool: return e["type"] == "ready" or e["type"] == "timer"):
		lines.append("\tpass")
	lines.append("")
	lines.append("func interact() -> void:")
	var interactions := 0
	for index in events.size():
		if events[index]["type"] == "interact":
			lines.append("\t_run_%d()" % index)
			interactions += 1
	if interactions == 0:
		lines.append("\tpass")
	for index in events.size():
		var event: Dictionary = events[index]
		if event["type"] == "timer":
			var seconds := float(event["properties"].get("seconds", 1.0))
			lines.append("")
			lines.append("func _timer_%d() -> void:" % index)
			if bool(event["properties"].get("repeat", true)):
				lines.append("\twhile is_inside_tree():")
				lines.append("\t\tawait get_tree().create_timer(%s).timeout" % str(seconds))
				lines.append("\t\tif is_inside_tree():")
				lines.append("\t\t\t_run_%d()" % index)
			else:
				lines.append("\tawait get_tree().create_timer(%s).timeout" % str(seconds))
				lines.append("\tif is_inside_tree():")
				lines.append("\t\t_run_%d()" % index)
		lines.append("")
		lines.append("func _run_%d() -> void:" % index)
		var start := str(flow[str(event["id"])].get("next", ""))
		if start.is_empty():
			lines.append("\tpass")
		else:
			_emit_chain(lines, nodes, flow, start, "\t")
	return {"error": "", "source": "\n".join(lines) + "\n"}

# Emits one flow chain. Plain actions run in sequence; a condition node
# evaluates its comparison and recurses into the labeled branch chains at a
# deeper indent, which ends the current segment. Validation has already
# guaranteed the graph is acyclic and every slot is wired at most once.
static func _emit_chain(lines: Array[String], nodes: Dictionary, flow: Dictionary, start: String, indent: String) -> void:
	var cursor := start
	while not cursor.is_empty():
		var action: Dictionary = nodes[cursor]
		lines.append("%sawait _trace_step(%s)" % [indent, _quoted(cursor)])
		if str(action["type"]) == "condition":
			var props: Dictionary = action["properties"]
			var suffix := _safe_name(action["id"])
			lines.append("%svar target_%s := get_node_or_null(NodePath(%s))" % [indent, suffix, _quoted(str(props.get("target", ".")))])
			lines.append("%sif _behavior_compare(target_%s, %s, %s, %s):" % [indent, suffix, _quoted(str(props.get("property", "visible"))), _quoted(str(props.get("operator", "=="))), JSON.stringify(props.get("value", false))])
			_emit_branch(lines, nodes, flow, str(flow[cursor].get("true", "")), indent + "\t")
			lines.append("%selse:" % indent)
			_emit_branch(lines, nodes, flow, str(flow[cursor].get("false", "")), indent + "\t")
			return
		_emit_action(lines, action, indent)
		cursor = str(flow[cursor].get("next", ""))

static func _emit_branch(lines: Array[String], nodes: Dictionary, flow: Dictionary, start: String, indent: String) -> void:
	if start.is_empty():
		lines.append("%spass" % indent)
	else:
		_emit_chain(lines, nodes, flow, start, indent)

static func publish(project: String, doc: Dictionary) -> Dictionary:
	var result := compile(doc)
	if not result["error"].is_empty():
		return result
	var base := project.path_join("assets/studio/generated/behaviors")
	var id := str(doc.get("id", ""))
	if not id.is_valid_filename() or id.is_empty():
		return {"error": "Behavior ID is not a safe filename.", "source": ""}
	var error := Store.write_json(Document.path(project, id), doc)
	if error != OK:
		return {"error": "Cannot save behavior document: %s" % error_string(error), "source": ""}
	error = DirAccess.make_dir_recursive_absolute(base)
	if error != OK:
		return {"error": "Cannot create generated behavior directory.", "source": ""}
	var target := base.path_join(id + ".gd")
	var file := FileAccess.open(target + ".tmp", FileAccess.WRITE)
	if file == null:
		return {"error": "Cannot write generated behavior script.", "source": ""}
	file.store_string(result["source"])
	file.flush()
	file.close()
	if FileAccess.file_exists(target):
		DirAccess.remove_absolute(target)
	error = DirAccess.rename_absolute(target + ".tmp", target)
	if error != OK:
		return {"error": "Cannot publish generated behavior script.", "source": ""}
	result["path"] = target
	return result

static func _emit_action(lines: Array[String], action: Dictionary, indent: String = "\t") -> void:
	var props: Dictionary = action["properties"]
	var path := str(props.get("target", "."))
	match str(action["type"]):
		"wait":
			lines.append("%sawait get_tree().create_timer(%s).timeout" % [indent, str(float(props.get("seconds", 1.0)))])
			lines.append("%sif not is_inside_tree(): return" % indent)
		"toggle_visible":
			lines.append("%svar target_%s := get_node_or_null(NodePath(%s))" % [indent, _safe_name(action["id"]), _quoted(path)])
			lines.append("%sif target_%s is CanvasItem or target_%s is Node3D:" % [indent, _safe_name(action["id"]), _safe_name(action["id"])])
			lines.append("%s\ttarget_%s.visible = not target_%s.visible" % [indent, _safe_name(action["id"]), _safe_name(action["id"])])
		"play_animation":
			var suffix := _safe_name(action["id"])
			lines.append("%svar target_%s := get_node_or_null(NodePath(%s)) as AnimationPlayer" % [indent, suffix, _quoted(path)])
			lines.append("%sif target_%s != null:" % [indent, suffix])
			lines.append("%s\tvar wanted_%s := %s" % [indent, suffix, _quoted(str(props.get("animation", "")))])
			lines.append("%s\tvar chosen_%s: StringName = &\"\"" % [indent, suffix])
			lines.append("%s\tfor clip in target_%s.get_animation_list():" % [indent, suffix])
			lines.append("%s\t\tif str(clip).to_lower() == wanted_%s.to_lower():" % [indent, suffix])
			lines.append("%s\t\t\tchosen_%s = clip" % [indent, suffix])
			lines.append("%s\t\t\tbreak" % indent)
			lines.append("%s\tif chosen_%s == &\"\" and not target_%s.get_animation_list().is_empty():" % [indent, suffix, suffix])
			lines.append("%s\t\tchosen_%s = target_%s.get_animation_list()[0]" % [indent, suffix, suffix])
			lines.append("%s\tif chosen_%s != &\"\":" % [indent, suffix])
			lines.append("%s\t\ttarget_%s.play(chosen_%s)" % [indent, suffix, suffix])
		"area_damage":
			var suffix := _safe_name(action["id"])
			lines.append("%svar sphere_%s := SphereShape3D.new()" % [indent, suffix])
			lines.append("%ssphere_%s.radius = %s" % [indent, suffix, str(float(props.get("radius", 3.0)))])
			lines.append("%svar query_%s := PhysicsShapeQueryParameters3D.new()" % [indent, suffix])
			lines.append("%squery_%s.shape = sphere_%s" % [indent, suffix, suffix])
			lines.append("%squery_%s.transform = Transform3D(Basis(), global_position)" % [indent, suffix])
			lines.append("%sfor hit in get_world_3d().direct_space_state.intersect_shape(query_%s, 64):" % [indent, suffix])
			lines.append("%s\tvar body: Object = hit.get(\"collider\")" % indent)
			lines.append("%s\tif body != null and body.has_method(\"take_damage\"):" % indent)
			lines.append("%s\t\tbody.take_damage(%s, global_position, false)" % [indent, str(float(props.get("amount", 0.0)))])
		"emit_event":
			lines.append("%sbehavior_event.emit(%s)" % [indent, _quoted(str(props.get("name", "event")))])

static func _safe_name(id: Variant) -> String:
	var result := ""
	for character in str(id):
		result += character if character.is_valid_identifier() or character.is_valid_int() else "_"
	return result

static func _quoted(value: String) -> String:
	return JSON.stringify(value)
