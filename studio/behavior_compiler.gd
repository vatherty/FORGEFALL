extends RefCounted

const Document = preload("res://behavior_document.gd")
const Store = preload("res://shared/document_store.gd")

static func compile(doc: Dictionary) -> Dictionary:
	var problem := Document.validate(doc)
	if not problem.is_empty():
		return {"error": problem, "source": ""}
	var nodes := {}
	var next := {}
	for entry in doc["nodes"]:
		nodes[str(entry["id"])] = entry
	for edge in doc["edges"]:
		next[str(edge["from"])] = str(edge["to"])
	var lines: Array[String] = ["extends Node3D", "# Generated by Forgefall Studio from behavior %s." % str(doc.get("id", "")), "# Edit the behavior document; this file is replaced on publication.", "signal behavior_event(name: String)", "signal behavior_step(id: String)", "signal behavior_paused(id: String)", "signal behavior_continue", "var debug_breakpoints: Array[String] = []", "", "func resume_behavior() -> void:", "\tbehavior_continue.emit()", "", "func _trace_step(id: String) -> void:", "\tbehavior_step.emit(id)", "\tif debug_breakpoints.has(id):", "\t\tbehavior_paused.emit(id)", "\t\tawait behavior_continue", "", "func _ready() -> void:"]
	var events: Array = []
	for entry in doc["nodes"]:
		if ["ready", "interact", "timer"].has(str(entry["type"])):
			events.append(entry)
	if events.is_empty():
		lines.append("\tpass")
	for index in events.size():
		var event: Dictionary = events[index]
		match str(event["type"]):
			"ready":
				lines.append("\t_run_%d()" % index)
			"timer":
				lines.append("\t_timer_%d()" % index)
	if not events.any(func(e: Dictionary) -> bool: return e["type"] == "ready" or e["type"] == "timer"):
		lines.append("\tpass")
	lines.append("")
	lines.append("func interact() -> void:")
	var interactions := 0
	for index in events.size():
		if events[index]["type"] == "interact":
			lines.append("\t_run_%d()" % index)
			interactions += 1
	if interactions == 0:
		lines.append("\tpass")
	for index in events.size():
		var event: Dictionary = events[index]
		if event["type"] == "timer":
			var seconds := float(event["properties"].get("seconds", 1.0))
			lines.append("")
			lines.append("func _timer_%d() -> void:" % index)
			if bool(event["properties"].get("repeat", true)):
				lines.append("\twhile is_inside_tree():")
				lines.append("\t\tawait get_tree().create_timer(%s).timeout" % str(seconds))
				lines.append("\t\tif is_inside_tree():")
				lines.append("\t\t\t_run_%d()" % index)
			else:
				lines.append("\tawait get_tree().create_timer(%s).timeout" % str(seconds))
				lines.append("\tif is_inside_tree():")
				lines.append("\t\t_run_%d()" % index)
		lines.append("")
		lines.append("func _run_%d() -> void:" % index)
		var cursor := str(event["id"])
		var visited := 0
		while next.has(cursor) and visited <= nodes.size():
			cursor = next[cursor]
			var action: Dictionary = nodes[cursor]
			lines.append("\tawait _trace_step(%s)" % _quoted(cursor))
			_emit_action(lines, action)
			visited += 1
		if visited == 0:
			lines.append("\tpass")
	return {"error": "", "source": "\n".join(lines) + "\n"}

static func publish(project: String, doc: Dictionary) -> Dictionary:
	var result := compile(doc)
	if not result["error"].is_empty():
		return result
	var base := project.path_join("assets/studio/generated/behaviors")
	var id := str(doc.get("id", ""))
	if not id.is_valid_filename() or id.is_empty():
		return {"error": "Behavior ID is not a safe filename.", "source": ""}
	var error := Store.write_json(Document.path(project, id), doc)
	if error != OK:
		return {"error": "Cannot save behavior document: %s" % error_string(error), "source": ""}
	error = DirAccess.make_dir_recursive_absolute(base)
	if error != OK:
		return {"error": "Cannot create generated behavior directory.", "source": ""}
	var target := base.path_join(id + ".gd")
	var file := FileAccess.open(target + ".tmp", FileAccess.WRITE)
	if file == null:
		return {"error": "Cannot write generated behavior script.", "source": ""}
	file.store_string(result["source"])
	file.flush()
	file.close()
	if FileAccess.file_exists(target):
		DirAccess.remove_absolute(target)
	error = DirAccess.rename_absolute(target + ".tmp", target)
	if error != OK:
		return {"error": "Cannot publish generated behavior script.", "source": ""}
	result["path"] = target
	return result

static func _emit_action(lines: Array[String], action: Dictionary) -> void:
	var props: Dictionary = action["properties"]
	var path := str(props.get("target", "."))
	match str(action["type"]):
		"wait":
			lines.append("\tawait get_tree().create_timer(%s).timeout" % str(float(props.get("seconds", 1.0))))
			lines.append("\tif not is_inside_tree(): return")
		"toggle_visible":
			lines.append("\tvar target_%s := get_node_or_null(NodePath(%s))" % [_safe_name(action["id"]), _quoted(path)])
			lines.append("\tif target_%s is CanvasItem or target_%s is Node3D:" % [_safe_name(action["id"]), _safe_name(action["id"])])
			lines.append("\t\ttarget_%s.visible = not target_%s.visible" % [_safe_name(action["id"]), _safe_name(action["id"])])
		"play_animation":
			var suffix := _safe_name(action["id"])
			lines.append("\tvar target_%s := get_node_or_null(NodePath(%s)) as AnimationPlayer" % [suffix, _quoted(path)])
			lines.append("\tif target_%s != null:" % suffix)
			lines.append("\t\tvar wanted_%s := %s" % [suffix, _quoted(str(props.get("animation", "")))])
			lines.append("\t\tvar chosen_%s: StringName = &\"\"" % suffix)
			lines.append("\t\tfor clip in target_%s.get_animation_list():" % suffix)
			lines.append("\t\t\tif str(clip).to_lower() == wanted_%s.to_lower():" % suffix)
			lines.append("\t\t\t\tchosen_%s = clip" % suffix)
			lines.append("\t\t\t\tbreak")
			lines.append("\t\tif chosen_%s == &\"\" and not target_%s.get_animation_list().is_empty():" % [suffix, suffix])
			lines.append("\t\t\tchosen_%s = target_%s.get_animation_list()[0]" % [suffix, suffix])
			lines.append("\t\tif chosen_%s != &\"\":" % suffix)
			lines.append("\t\t\ttarget_%s.play(chosen_%s)" % [suffix, suffix])
		"area_damage":
			var suffix := _safe_name(action["id"])
			lines.append("\tvar sphere_%s := SphereShape3D.new()" % suffix)
			lines.append("\tsphere_%s.radius = %s" % [suffix, str(float(props.get("radius", 3.0)))])
			lines.append("\tvar query_%s := PhysicsShapeQueryParameters3D.new()" % suffix)
			lines.append("\tquery_%s.shape = sphere_%s" % [suffix, suffix])
			lines.append("\tquery_%s.transform = Transform3D(Basis(), global_position)" % suffix)
			lines.append("\tfor hit in get_world_3d().direct_space_state.intersect_shape(query_%s, 64):" % suffix)
			lines.append("\t\tvar body: Object = hit.get(\"collider\")")
			lines.append("\t\tif body != null and body.has_method(\"take_damage\"):")
			lines.append("\t\t\tbody.take_damage(%s, global_position, false)" % str(float(props.get("amount", 0.0))))
		"emit_event":
			lines.append("\tbehavior_event.emit(%s)" % _quoted(str(props.get("name", "event"))))

static func _safe_name(id: Variant) -> String:
	var result := ""
	for character in str(id):
		result += character if character.is_valid_identifier() or character.is_valid_int() else "_"
	return result

static func _quoted(value: String) -> String:
	return JSON.stringify(value)
