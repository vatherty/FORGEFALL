extends SceneTree

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	var fixture := ProjectSettings.globalize_path("user://studio_maps_" + str(Time.get_ticks_usec()))
	DirAccess.make_dir_recursive_absolute(fixture.path_join("studio/shared"))
	DirAccess.make_dir_recursive_absolute(fixture.path_join("tools"))
	var project := FileAccess.open(fixture.path_join("project.godot"), FileAccess.WRITE)
	project.store_string("config_version=5\n[application]\nconfig/name=\"Forgefall\"\n")
	project.close()
	for name in ["document_store.gd", "asset_document.gd", "voxel_mesh.gd"]:
		var output := FileAccess.open(fixture.path_join("studio/shared/" + name), FileAccess.WRITE)
		output.store_string(FileAccess.get_file_as_string(ProjectSettings.globalize_path("res://shared/" + name)))
		output.close()
	var generator := FileAccess.open(fixture.path_join("tools/studio_generate.gd"), FileAccess.WRITE)
	generator.store_string(FileAccess.get_file_as_string(ProjectSettings.globalize_path("res://../tools/studio_generate.gd")))
	generator.close()
	var studio: Control = load("res://main.tscn").instantiate()
	root.add_child(studio)
	studio._open_project(fixture)
	studio._new_map()
	studio._add_block()
	studio._edit_vector_component("45", "rotation", 1)
	studio._group_selected()
	assert(str(studio.map_doc["instances"][0].get("group_id", "")) != "")
	var behavior_id := "test-behavior"
	var behavior_dir := fixture.path_join("assets/studio/generated/behaviors")
	DirAccess.make_dir_recursive_absolute(behavior_dir)
	var behavior := FileAccess.open(behavior_dir.path_join(behavior_id + ".gd"), FileAccess.WRITE)
	behavior.store_string("extends Node3D\nfunc interact() -> void:\n\tset_meta(\"used\", true)\n")
	behavior.close()
	studio._edit_property(behavior_id, "behavior_id")
	studio._add_feature("marker")
	studio._edit_axis("3", 0)
	studio._add_feature("light")
	studio._add_feature("volume")
	studio._add_feature("navigation")
	assert(studio.map_doc["instances"].size() == 5)
	var map_id: String = studio.map_doc["id"]
	assert(studio._save())
	studio._publish_map()
	var scene_path := fixture.path_join("assets/studio/generated/maps/" + map_id + ".tscn")
	assert(FileAccess.file_exists(scene_path))
	var source := FileAccess.get_file_as_string(scene_path)
	assert(source.contains("StaticBody3D"))
	assert(source.contains("Transform3D(0.707"))
	assert(source.contains("studio_group"))
	assert(source.contains("studio_interactable"))
	assert(source.contains("test-behavior.gd"))
	assert(source.contains("CollisionShape3D"))
	assert(source.contains("player_spawn"))
	assert(source.contains("OmniLight3D"))
	assert(source.contains("Area3D"))
	assert(source.contains("NavigationRegion3D"))
	var catalog: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(fixture.path_join("assets/studio/generated/catalog.json")))
	assert(catalog["maps"][map_id]["scene"] == "res://assets/studio/generated/maps/" + map_id + ".tscn")
	print("Map test passed: edit transforms, markers, light, volume, navigation; publish collision and catalog")
	quit()
