extends SceneTree

const Store = preload("res://shared/document_store.gd")
const History = preload("res://command_history.gd")

func _initialize() -> void:
	assert(Store.validate_target(ProjectSettings.globalize_path("res://..")) == "")
	var doc: Dictionary = Store.new_map("Foundation Test")
	assert(Store.validate_map(doc) == "")
	var original_id: String = doc["id"]
	var history := History.new()
	var changed: Dictionary = doc.duplicate(true)
	changed["instances"].append(Store.new_instance("Block", Vector3(1, 0, 2)))
	doc = history.execute(doc, "Add block", changed)
	assert(doc["instances"].size() == 1)
	assert(doc["id"] == original_id)
	doc = history.undo(doc)
	assert(doc["instances"].is_empty())
	doc = history.redo(doc)
	assert(doc["instances"].size() == 1)
	var persisted: Dictionary = history.to_dict()
	var reopened := History.new()
	reopened.load_dict(persisted, doc)
	assert(reopened.can_undo())
	assert(reopened.undo(doc)["instances"].is_empty())
	var stale := doc.duplicate(true)
	stale["name"] = "Changed externally"
	reopened.load_dict(persisted, stale)
	assert(not reopened.can_undo())
	var malformed: Dictionary = persisted.duplicate(true)
	malformed["past"][0]["after"]["id"] = "different-map"
	reopened.load_dict(malformed, doc)
	assert(not reopened.can_undo())
	var count_before: int = history.to_dict()["past"].size()
	history.execute(doc, "No change", doc)
	assert(history.to_dict()["past"].size() == count_before)
	var test_path := ProjectSettings.globalize_path("user://foundation_test.json")
	assert(Store.write_json(test_path, doc) == OK)
	var loaded: Dictionary = Store.read_json(test_path)
	assert(Store.validate_map(loaded) == "")
	assert(loaded["instances"][0]["id"] == doc["instances"][0]["id"])
	DirAccess.remove_absolute(test_path)
	print("Foundation test passed: target, map, history, persistence")
	quit()
