extends SceneTree
const Asset = preload("res://shared/asset_document.gd")
const Store = preload("res://shared/document_store.gd")
func _initialize() -> void:
	call_deferred("_run")
func _run() -> void:
	var fixture := ProjectSettings.globalize_path("user://asset_pipeline_fixture_" + str(Time.get_ticks_usec()))
	DirAccess.make_dir_recursive_absolute(fixture.path_join("tools"))
	DirAccess.make_dir_recursive_absolute(fixture.path_join("studio/shared"))
	var config := FileAccess.open(fixture.path_join("project.godot"), FileAccess.WRITE)
	config.store_string("config_version=5\n[application]\nconfig/name=\"Forgefall\"\n")
	config.close()
	for name in ["document_store.gd", "asset_document.gd", "voxel_mesh.gd"]:
		var source := ProjectSettings.globalize_path("res://shared/" + name)
		var target := FileAccess.open(fixture.path_join("studio/shared").path_join(name), FileAccess.WRITE)
		target.store_string(FileAccess.get_file_as_string(source))
		target.close()
	var helper := FileAccess.open(fixture.path_join("tools/studio_generate.gd"), FileAccess.WRITE)
	helper.store_string(FileAccess.get_file_as_string(ProjectSettings.globalize_path("res://../tools/studio_generate.gd")))
	helper.close()
	var workshop: Control = load("res://asset_workshop.tscn").instantiate()
	workshop.project_path = fixture
	root.add_child(workshop)
	workshop.axis_inputs[0].value = 1
	workshop._apply_coordinates()
	workshop._save()
	workshop._publish()
	var asset_path: String = Asset.path(fixture, workshop.asset_doc["id"])
	assert(FileAccess.file_exists(asset_path))
	assert(FileAccess.file_exists(fixture.path_join("assets/studio/generated/assets").path_join(workshop.asset_doc["id"] + ".tscn")))
	var studio: Control = load("res://main.tscn").instantiate()
	root.add_child(studio)
	studio._open_project(fixture)
	studio._new_map()
	studio._place_asset(asset_path)
	assert(studio.map_doc["instances"].size() == 1)
	assert(studio.map_doc["instances"][0]["asset_id"] == workshop.asset_doc["id"])
	studio._publish_map()
	assert(FileAccess.file_exists(fixture.path_join("assets/studio/generated/maps").path_join(studio.map_doc["id"] + ".tscn")))
	var updated: Dictionary = Asset.set_voxel(workshop.asset_doc, 2, 0, 0, 0)
	assert(Store.write_json(asset_path, updated) == OK)
	var executable := OS.get_executable_path()
	var output := []
	var code := OS.execute(executable, ["--headless", "--path", fixture, "--script", "res://tools/studio_generate.gd", "--", "asset", str(updated["id"])], output, true)
	assert(code == 0)
	DirAccess.make_dir_recursive_absolute(fixture.path_join("scripts/studio"))
	var adapter := FileAccess.open(fixture.path_join("scripts/studio/studio_catalog.gd"), FileAccess.WRITE)
	adapter.store_string(FileAccess.get_file_as_string(ProjectSettings.globalize_path("res://../scripts/studio/studio_catalog.gd")))
	adapter.close()
	var verifier := FileAccess.open(fixture.path_join("tools/verify_studio_linked.gd"), FileAccess.WRITE)
	verifier.store_string(FileAccess.get_file_as_string(ProjectSettings.globalize_path("res://../tools/verify_studio_linked.gd")))
	verifier.close()
	output.clear()
	code = OS.execute(executable, ["--headless", "--path", fixture, "--script", "res://tools/verify_studio_linked.gd", "--", str(studio.map_doc["id"]), "84"], output, true)
	assert(code == 0)
	print("Asset pipeline test passed: workshop, linked instance, publication, live asset refresh")
	quit()
